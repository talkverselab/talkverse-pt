  "twist_type":"chaos",
  "flags":[],
  "goal":"놀란 말에 짧게 받아치기 — 「epá」「pois é」",
  "expressions":["epá", "pois é"],
  "turns":[
   {"speaker": "B", "tl": "Epá! Quem fez isto?", "ko": "헐! 이거 누가 했어?", "note": "quem fez? = 누가 했어?", "tags": ["expr:epá", "form:fazer"], "emotion": "surprised"},
   {"speaker": "A", "tl": "Eu? Não fiz nada.", "ko": "나? 아무것도 안 했어.", "note": "fiz = (내가) 했다 · nada = 아무것도", "tags": ["form:fazer"], "emotion": "neutral"},
   {"speaker": "B", "tl": "A casa está muito bem!", "ko": "집이 완전 멀쩡해!", "note": "está muito bem = 아주 좋아", "tags": ["form:estar"], "emotion": "shout"},
   {"speaker": "A", "tl": "Pois é. Não fui eu.", "ko": "그러게. 난 아니야.", "note": "pois é = 그러게, fui = 내가 ~였다 (ser)", "tags": ["expr:pois é"], "emotion": "tsukkomi"},
   {"speaker": "B", "tl": "Foi a Inês? A Beatriz?", "ko": "Inês야? Beatriz야?", "note": "foi = ~였어 (ser)", "tags": ["form:ser"], "emotion": "worried"},
   {"speaker": "A", "tl": "Foi o teu pai. Ainda está aqui.", "ko": "너네 아빠. 아직 여기 계셔.", "note": "o teu pai = 너네 아빠, ainda = 아직", "tags": ["twist"], "segs": [["neutral", "Foi o teu pai."], ["worried", " Ainda está aqui."]]}
  ]},
