  "expressions":["afinal", "não faz mal", "fixe", "então", "quer dizer", "pronto"],
  "turns":[
   {"speaker": "B", "tl": "Afinal não posso ir!", "ko": "나 결국 못 가!", "note": "afinal = 결국, 알고 보니", "tags": ["expr:afinal", "form:poder"], "emotion": "worried", "ui": "bubble", "at": "19:10"},
   {"speaker": "A", "tl": "Tudo bem. Não faz mal.", "ko": "괜찮아. 신경 쓰지 마.", "note": "não faz mal = 괜찮아", "tags": ["expr:não faz mal"], "emotion": "gentle", "ui": "bubble", "at": "19:11"},
   {"speaker": "B", "tl": "Vou para a praia, pá!", "ko": "나 바다 간다!", "note": "praia = 해변 (상한 밖 낱말)", "tags": ["form:ir"], "emotion": "excited", "ui": "bubble", "at": "19:11"},
