  "goal":"느긋한 친구에게 짧게 반응하기 — 「olha」「a sério?」「fixe」",
  "expressions":["olha", "a sério?", "pá", "fixe", "então"],
  "turns":[
   {"speaker": "A", "tl": "Tiago, estás a fazer o quê?", "ko": "Tiago, 뭐 해?", "note": "estás a fazer o quê? = 뭐 하고 있어?", "tags": ["form:estar a"], "emotion": "amused"},
   {"speaker": "B", "tl": "Olha... faço uma coisa para ti.", "ko": "있잖아… 너 주려고 뭐 만드는 중이야.", "note": "faço = (내가) 만들다 · coisa = 것", "tags": ["expr:olha", "form:fazer"], "emotion": "gentle"},
   {"speaker": "A", "tl": "Para mim? És mesmo fixe!", "ko": "나한테? 너 진짜 멋지다!", "note": "és = (너는) ~이다 · fixe = 멋지다", "tags": ["expr:fixe", "form:ser"], "emotion": "surprised"},
   {"speaker": "B", "tl": "Sim. É só para ti, pá.", "ko": "응. 너만을 위한 거야.", "note": "é para ti = 너를 위한 거야 · só = 오직, ~만", "tags": ["expr:pá", "form:ser"], "emotion": "gentle"},
   {"speaker": "A", "tl": "Fixe! Então... já posso falar?", "ko": "멋지다! 그럼… 이제 말해도 돼?", "note": "já posso falar? = 이제 말해도 돼?", "tags": ["expr:fixe", "expr:então"], "emotion": "teasing"},
   {"speaker": "B", "tl": "Ainda não podes. Mais uma vez.", "ko": "아직 안 돼. 한 번 더.", "note": "podes = (너는) ~할 수 있다 · mais uma vez = 한 번 더", "tags": ["twist", "form:poder"], "emotion": "amused"}
  ]},
