  "turns":[
   {"speaker": "B", "tl": "Então, tu não falas comigo?", "ko": "뭐야, 나랑은 말 안 해?", "note": "falas comigo = 나랑 말해", "tags": ["expr:então", "form:falar"], "emotion": "teasing"},
