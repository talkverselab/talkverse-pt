  "emoji":"📱",
  "scene":"밤 11시 40분, Inês 가 먼저 메시지를 보낸다. 다급한 「지금 와」의 진짜 이유는 따로 있다.",
  "speakers":{"A": "{name}", "B": "Inês"},
  "cast":{"B": "ines"},
  "register":"chat",
  "twist":5,
  "twist_type":"chaos",
  "flags":["romance"],
  "goal":"짧은 채팅 덩어리로 답하기 — 「tudo bem?」「a sério?」「pronto」",
  "expressions":["tudo bem?", "a sério?", "é que"],
  "turns":[
   {"speaker": "B", "tl": "Olá! Estás em casa?", "ko": "안녕! 집이야?", "note": "Estás em casa? = 집에 있어?", "tags": ["form:estar"], "emotion": "cheerful", "ui": "bubble", "at": "23:41"},
   {"speaker": "A", "tl": "Estou. Queres o quê?", "ko": "응. 뭐 필요해?", "note": "queres = (너는) 원하다 (queria 와 같은 querer)", "tags": ["expr:tudo bem?", "form:querer"], "emotion": "neutral", "ui": "bubble", "at": "23:41"},
   {"speaker": "B", "tl": "Vem à minha casa. Agora!", "ko": "우리 집으로 와. 지금!", "note": "vem = 와(tu 에게 하는 말)", "tags": ["form:vir"], "emotion": "excited", "ui": "bubble", "at": "23:42"},
   {"speaker": "A", "tl": "A sério? Vou já!", "ko": "진짜? 바로 갈게!", "note": "a sério? = 진짜?, vou já = 금방 갈게", "tags": ["expr:a sério?"], "segs": [["surprised", "A sério?"], ["excited", " Vou já!"]], "ui": "bubble", "at": "23:42"},
   {"speaker": "B", "tl": "É que há uma barata aqui!", "ko": "그게, 여기 바퀴벌레가 있거든!", "note": "barata = 바퀴벌레 (상한 밖 낱말)", "tags": ["twist", "expr:pronto"], "emotion": "shout", "ui": "bubble", "at": "23:42"},
   {"speaker": "B", "tl": "E... também te queria ver.", "ko": "그리고… 너도 보고 싶었어.", "note": "te queria ver = 너를 보고 싶었어(부드러운 반과거)", "tags": ["heart", "expr:pronto"], "emotion": "shy", "ui": "bubble", "at": "23:43"}
  ]},
 {"id":"r0_friends_c1",
  "region":"R0",
