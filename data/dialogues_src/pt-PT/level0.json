   {"speaker": "B", "tl": "Para ti, tenho sempre tempo.", "ko": "너한텐 시간 늘 있어.", "note": "tenho sempre tempo = 시간은 늘 있어", "tags": ["heart"], "emotion": "gentle", "ui": "bubble", "at": "19:12"},
   {"speaker": "B", "tl": "Quer dizer... para todos! Pronto.", "ko": "아니 그러니까… 다들한테! 됐지.", "note": "quer dizer = 그러니까, 내 말은", "tags": ["twist", "expr:quer dizer", "expr:pronto"], "emotion": "flustered", "ui": "bubble", "at": "19:12"}
  ]},
