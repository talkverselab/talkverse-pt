 },
 "register": "casual",
 "twist": 9,
 "twist_type": "chaos",
 "flags": [],
 "goal": "넓은 어휘, 새 문법 없음 — 넓은 어휘 — 경기장 말(golo·árbitro·bancada)",
 "expressions": [
  "golo!",
  "vá lá",
